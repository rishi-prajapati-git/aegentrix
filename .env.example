# AEGENTRIX - Environment Configuration Template
# Copy this file to .env and adjust values for local development.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage / Persistence
DATABASE_URL=sqlite:///./backend/data/aegentrix.db

# Advisory AI Security Model Configuration (Optional)
# If no provider key is provided, system operates in deterministic fallback mode.
AI_ANALYSIS_ENABLED=false
AI_MODEL_PROVIDER=none
AI_MODEL_NAME=gemma-2b-it
AI_MODEL_API_KEY=

# Security Invariant Thresholds & Cryptography
APPROVAL_SECRET_KEY=aegentrix-super-secret-hmac-key-2026
DEFAULT_POLICY_FILE=./backend/app/data/policies.yaml
TEMPORAL_WINDOW_SECONDS=300
MAX_CONSECUTIVE_DENIALS_THRESHOLD=3
DATA_READ_THRESHOLD_BYTES=50000
